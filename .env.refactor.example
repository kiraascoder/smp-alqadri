# Tambahkan nilai ini ke .env lokal/production sebelum php artisan db:seed
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
ADMIN_PHONE=""

# Password reset membutuhkan mailer aktif.
